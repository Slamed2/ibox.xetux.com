# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://ibox:dev_password@localhost:5432/ibox

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=random_secret_string_here

# Chatwoot
CHATWOOT_BASE_URL=https://your-chatwoot-instance.com
CHATWOOT_API_TOKEN=your_api_token_here
CHATWOOT_WEBHOOK_SECRET=your_webhook_secret_here
CHATWOOT_ACCOUNT_ID=1

# Red de seguridad: asigna a Soporte VE las conversaciones que quedan abiertas
# sin equipo y sin agente. Viene APAGADA por defecto en el código, así que si
# no está aquí ni en el entorno del despliegue, sencillamente no corre.
AUTO_ASSIGN_ENABLED=true
AUTO_ASSIGN_AGE_MINUTES=10   # antigüedad desde la creación para asignar
AUTO_ASSIGN_SWEEP_MINUTES=2  # cada cuánto se barre
